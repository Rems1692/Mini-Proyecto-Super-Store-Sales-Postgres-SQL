INSERT INTO CLIENTES_SS (
CUSTOMER_ID,
CUSTOMER_NAME,
SEGMENT
)
SELECT DISTINCT
CUSTOMER_ID,
CUSTOMER_NAME,
SEGMENT
FROM SUPERSTORE_RAW   'TABLA CLIENTES_SS'


INSERT INTO PRODUCTOS_SS
SELECT DISTINCT
PRODUCT_ID,
PRODUCT_NAME,
CATEGORY,
SUB_CATEGORY
FROM SUPERSTORE_RAW; 'SE INSERTO SIN LLAVE PRIMARIA PORQUE TENEMOS REGISTROS QUE TIENES DOS NOMBRES DIFERENTES'