9 - ¿CUAL ES EL TICKET PROMEDIO POR CLIENTE?
    SELECT 
    C.CUSTOMER_ID, 
    C.CUSTOMER_NAME, 
    ROUND(SUM (V.SALES) / COUNT(DISTINCT V.ORDER_ID),2)
        AS TICKET_PROMEDIO 
    FROM CLIENTES_SS C 
    JOIN VENTAS_SS V 
        ON V.CUSTOMER_ID = C.CUSTOMER_ID 
    GROUP BY 
    C.CUSTOMER_ID, 
    C.CUSTOMER_NAME 
    ORDER BY 
    TICKET_PROMEDIO DESC

  -- ESTE ES EL VALOR PROMEDIO DE VENTAS POR PEDIDOS.


10 - ¿CUAL ES EL VALOR PROMEDIO POR LINEA DE VENTA?
    SELECT
        C.CUSTOMER_ID,
        C.CUSTOMER_NAME,
        ROUND(AVG(V.SALES),2) AS VALOR_PROMEDIO_LINEA
    FROM CLIENTES_SS C
    JOIN VENTAS_SS V
        ON V.CUSTOMER_ID = C.CUSTOMER_ID
    GROUP BY
        C.CUSTOMER_ID,
        C.CUSTOMER_NAME
    ORDER BY
        VALOR_PROMEDIO_LINEA DESC;

 -- ESTE ES EL VALOR PROMEDIO DE CADA LINEA DE VENTA.

11 - ¿QUÉ SEGMENTO VENDE MAS?
    SELECT 
    C.SEGMENT, 
    ROUND(SUM(V.SALES),2) 
        AS VENTAS_TOTALES 
    FROM CLIENTES_SS C 
    JOIN VENTAS_SS V 
        ON V.CUSTOMER_ID = C.CUSTOMER_ID 
    GROUP BY 
    C.SEGMENT 
    ORDER BY 
    VENTAS_TOTALES DESC;

12 - ¿QUÉ PORCENTAJE DE VENTAS APORTA CADA SEGMENTO?
    SELECT 
    C.SEGMENT,
    ROUND(SUM(V.SALES),2) 
        AS VENTAS_TOTALES,
    ROUND(SUM(V.SALES) * 100.0/
        SUM(SUM(v.SALES)) OVER (),2)  --"Haz este cálculo sobre todas las filas del resultado."
        AS PORCENTAJE
    FROM CLIENTES_SS C
    JOIN VENTAS_SS V
        ON V.CUSTOMER_ID = C.CUSTOMER_ID
    GROUP BY
    C.SEGMENT
    ORDER BY
    VENTAS_TOTALES DESC;

