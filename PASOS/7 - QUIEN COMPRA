7 - ¿QUIÉNES COMPRARON MÁS UNIDADES?                                                                                            
    SELECT 
    C.CUSTOMER_ID,
    C.CUSTOMER_NAME,
    SUM(QUANTITY) 
        AS CANTIDAD_TOTAL
    FROM CLIENTES_SS C
    JOIN VENTAS_SS V
    ON V.CUSTOMER_ID = C.CUSTOMER_ID
    GROUP BY
    C.CUSTOMER_ID,
    C.CUSTOMER_NAME
    ORDER BY
    CANTIDAD_TOTAL DESC;

8 - ¿CLIENTES MAS VALIOSOS?
    SELECT 
